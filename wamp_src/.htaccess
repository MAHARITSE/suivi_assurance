# =====================================================================
#  SUIVI ASSURANCE SALFA — Configuration Apache (déploiement WAMP)
# =====================================================================
#  Placez ce dossier complet dans :  C:\wamp64\www\<votre-dossier>\
#  Puis accédez à :                  http://localhost/<votre-dossier>/
# =====================================================================

# Pas de liste de répertoire — uniquement index.html
Options -Indexes
DirectoryIndex index.html

# Encodage UTF-8
AddDefaultCharset UTF-8

# Taille maximale des requêtes POST (import groupé de données) : 25 Mo
LimitRequestBody 26214400

# --------------------------------------------------------------------
#  Sécurité : fichiers de configuration et de schéma non accessibles
# --------------------------------------------------------------------
<FilesMatch "^config\.php$">
    Require all denied
</FilesMatch>
