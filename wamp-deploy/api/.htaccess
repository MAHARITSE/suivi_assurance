# Rules pour le sous-dossier API WAMP
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /suivi-assurance/api/

    # Si le fichier ou dossier existe réellement, le servir directement
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rediriger toutes les requêtes /api/xxx vers index.php?action=xxx
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?action=$1 [QSA,L]
</IfModule>
