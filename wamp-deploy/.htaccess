# Configuration Apache pour le déploiement Suivi Assurance SALFA sur WAMP Server
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /suivi-assurance/

    # Autoriser l'accès direct aux fichiers de l'API
    RewriteRule ^api/(.*)$ api/index.php?action=$1 [QSA,L]
    RewriteRule ^api.php$ api/api.php [QSA,L]

    # Ne pas réécrire les ressources statiques existantes (JS, CSS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rediriger toutes les autres routes SPA vers index.html
    RewriteRule ^ index.html [L]
</IfModule>

# En-têtes de sécurité & CORS
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# Encodage UTF-8 par défaut
AddDefaultCharset UTF-8
