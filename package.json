{
  "name": "suivi-assurance-salfa",
  "version": "1.0.0",
  "description": "Application SALFA de gestion et suivi des assurances santé",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "esbuild": "^0.21.5",
    "tsx": "^4.11.2",
    "typescript": "^5.4.5"
  }
}
